# Front-end assets (website + ombucore). Compiled output is not committed.
FROM node:22-alpine AS assets

WORKDIR /src

COPY package.json package-lock.json ./
COPY lib/ombucore/frontend/package.json lib/ombucore/frontend/
RUN npm ci

COPY . .
RUN npm run build

FROM python:3.13-alpine3.22

LABEL maintainer="OMBU"

WORKDIR /var/www

COPY requirements requirements

# postgresql-client is used by the wait-for-postgres.sh script
# setuptools is an unpinned declared requirement of django-polymorphic that we can't pin in the requirements.txt

RUN apk add --no-cache  \
    postgresql-client \
    chromium \
    && apk upgrade \
    && apk upgrade sqlite cargo \
    && pip install --no-cache-dir -r requirements/development.txt \
    && pip install --no-cache-dir setuptools

COPY . .

# Compiled front-end assets from the `assets` stage.
COPY --from=assets /src/website/static/website website/static/website
COPY --from=assets /src/lib/ombucore/admin/static lib/ombucore/admin/static

ENV DJANGO_SETTINGS_MODULE=website.settings.docker

EXPOSE 8000

ENTRYPOINT  ["sh", "./docker/wait-for-postgres.sh"]

CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]
